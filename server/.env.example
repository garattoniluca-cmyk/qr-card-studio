# QR Card Studio — modello di configurazione. Copiare in server/.env e compilare.
# Le password reali stanno solo in server/.env e in docs/local DBs.txt (entrambi ignorati da git).
PORT=8080
HOST=0.0.0.0
# URL pubblico fisso (vuoto = rilevamento automatico dell'IP LAN). Es.: https://schede.esempio.it
PUBLIC_BASE_URL=
# Porta usata per l'URL automatico (vuoto = PORT). In sviluppo npm run dev usa 5173.
PUBLIC_PORT=
# true solo dietro reverse proxy HTTPS (nginx): abilita il cookie Secure
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=infoqrshow
DB_USER=qrcard_app
DB_PASSWORD=

# Utente per i database di test qrcard_test_*
TEST_DB_USER=qrcard_test
TEST_DB_PASSWORD=

# Utente amministrativo MySQL usato SOLO da npm run setup
SETUP_DB_USER=root
SETUP_DB_PASSWORD=

# Hash bcrypt della password admin (lo genera npm run setup)
ADMIN_PASSWORD_HASH=
# Stringa casuale lunga per firmare il cookie di sessione
SESSION_SECRET=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
